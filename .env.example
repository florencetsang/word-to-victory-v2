# Supabase project (local defaults shown; `npx supabase status` prints them)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `npx supabase status`>
# Comma-separated OAuth providers enabled in Supabase Auth (google, apple). Leave empty locally.
VITE_AUTH_PROVIDERS=
