# Supabase project (local defaults shown; `npx supabase status` prints them)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `npx supabase status`>
# Comma-separated OAuth providers enabled in Supabase Auth (google, apple). Leave empty locally.
VITE_AUTH_PROVIDERS=

# --- Native app (iOS/Android) only; the website ignores these. See docs/mobile-launch.md. ---
# Public website URL, used for invite and share links created in the app.
VITE_PUBLIC_SITE_URL=
# Google OAuth client IDs from Google Cloud Console (the web one is also set in Supabase).
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
